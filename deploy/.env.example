# Copy to deploy/.env and replace every value before starting services.
# Use generated random values; do not commit deploy/.env or reuse production secrets.
POSTGRES_IMAGE=pgvector/pgvector:pg16
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_PORT=5432
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0

REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_PORT=6379
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=1.0

MINIO_ROOT_USER=agent-platform
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MEMORY_LIMIT=2g
MINIO_CPU_LIMIT=2.0
