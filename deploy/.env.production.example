# Production Compose overlay. Copy to deploy/.env.production and protect with chmod 600.
# Build and publish an immutable image containing this repository, requirements-platform.txt
# and uvicorn. The repository-owned ASGI and worker entrypoints are the defaults below.
PLATFORM_API_IMAGE=ghcr.io/your-org/agent-platform@sha256:REPLACE_WITH_IMAGE_DIGEST
PLATFORM_ASGI_APP=agent_platform.production:app
WEB_CONCURRENCY=2
PLATFORM_WORKER_MODULE=agent_platform.worker

# Optional durable alert notification dispatcher (start with Compose --profile alerts).
# Keep URL and allowlist empty until a reviewed HTTPS provider is configured.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_ALLOWED_HOSTS=
# Optional: set container path below and host-side secret path when provider auth is required.
ALERT_WEBHOOK_AUTHORIZATION_FILE=
ALERT_WEBHOOK_AUTHORIZATION_HOST_PATH=
ALERT_DISPATCH_POLL_INTERVAL_SECONDS=5
ALERT_DISPATCH_BATCH_SIZE=100
ALERT_WORKER_MEMORY_LIMIT=512m
ALERT_WORKER_CPU_LIMIT=1.0
WORKER_CONCURRENCY=2
PLATFORM_API_PORT=8080
ALLOWED_ORIGINS=https://agent.example.com

# Instance-wide authentication mode; false is the clean-install default.
# Set true only when the deployment bootstrap supplies identity + identity_repository.
AUTH_ENABLED=false

# Required production egress boundary: managed proxy URL and explicit hostname allowlist.
# The network firewall/security group must deny direct Internet egress from application
# workloads; proxy environment variables alone are not a network enforcement boundary.
EGRESS_PROXY_URL=https://egress-proxy.example.internal:8443
EGRESS_ALLOWED_HOSTS=api.openai.com,api.anthropic.com
NO_PROXY=postgres,redis,minio,localhost,127.0.0.1

POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PORT=5432
POSTGRES_PASSWORD_FILE=/etc/agent-platform/secrets/postgres_password

REDIS_IMAGE=redis:7-alpine
REDIS_PORT=6379
REDIS_PASSWORD_FILE=/etc/agent-platform/secrets/redis_password
REDIS_MAX_MEMORY=512mb

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=agent-platform
MINIO_ROOT_PASSWORD_FILE=/etc/agent-platform/secrets/minio_root_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_BUCKET=agent-platform

API_MEMORY_LIMIT=2g
API_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2g
WORKER_CPU_LIMIT=2.0
POSTGRES_MEMORY_LIMIT=4g
POSTGRES_CPU_LIMIT=4.0
POSTGRES_SHM_SIZE=256m
REDIS_MEMORY_LIMIT=1g
REDIS_CPU_LIMIT=1.0
MINIO_MEMORY_LIMIT=2g
MINIO_CPU_LIMIT=2.0
