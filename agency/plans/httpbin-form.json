{
  "url": "https://httpbin.org/forms/post",
  "steps": [
    {"action": "open", "url": "https://httpbin.org/forms/post"},
    {"action": "snapshot"},
    {"action": "fill", "fields": [
      {"selector": {"role": "textbox", "name": "Customer name:"}, "value": "龙奕"},
      {"selector": {"role": "textbox", "name": "Telephone:"}, "value": "13800000000"},
      {"selector": {"role": "textbox", "name": "E-mail address:"}, "value": "test@example.com"}
    ]},
    {"action": "click", "selector": {"role": "button", "name": "Submit order"}},
    {"action": "assert", "expect": {"url_contains": "httpbin.org/post", "text_contains": "custname"}},
    {"action": "screenshot"}
  ]
}
