# Local development configuration. Copy to .env and replace all REPLACE_* values.
# Never commit .env or reuse these credentials outside local development.

# Database / infrastructure (deploy/compose.yaml)
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPU_LIMIT=2.0

REDIS_IMAGE=redis:7-alpine
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
REDIS_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=1.0

MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=agent-platform
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_MINIO_PASSWORD
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_MEMORY_LIMIT=2g
MINIO_CPU_LIMIT=2.0
OBJECT_STORAGE_BUCKET=agent-platform

# Runtime / API and worker
APP_ENV=development
LOG_LEVEL=INFO
PLATFORM_ASGI_APP=deploy.local_app:app
PLATFORM_WORKER_MODULE=agent_platform.worker
PLATFORM_API_PORT=8080
WEB_CONCURRENCY=1
WORKER_CONCURRENCY=1
AGENT_PLATFORM_RUN_WORKER_ENABLED=true
AGENT_PLATFORM_REQUIRE_RUN_EXECUTION=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOCAL_TENANT_ID=local
LOCAL_OWNER_EMAIL=
LOCAL_OBJECT_STORAGE_DIR=.local-data/files

# OpenAI-compatible model provider (optional for model-backed runs)
SENSENOVA_API_KEY=
SENSENOVA_API_KEYS=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Cost / usage controls (USD; configure policy in the tenant quota service)
MODEL_DEFAULT_INPUT_COST_PER_1K_TOKENS=0
MODEL_DEFAULT_OUTPUT_COST_PER_1K_TOKENS=0
COST_CURRENCY=USD
COST_ALERT_THRESHOLD_USD=10
COST_HARD_LIMIT_USD=25

# Budget defaults (limits are policy inputs; enforcement is server-side)
BUDGET_PERIOD=monthly
BUDGET_HARD_TOKENS=100000
BUDGET_SOFT_TOKENS=80000
BUDGET_HARD_COST_USD=25
BUDGET_SOFT_COST_USD=20
BUDGET_HARD_CONCURRENCY=2
BUDGET_HARD_INPUT_TOKENS=80000
BUDGET_HARD_OUTPUT_TOKENS=20000
BUDGET_HARD_CONTEXT_WINDOW_TOKENS=32000

# Optional managed outbound proxy. Keep empty for local-only development.
EGRESS_PROXY_URL=
EGRESS_ALLOWED_HOSTS=
NO_PROXY=localhost,127.0.0.1,postgres,redis,minio
